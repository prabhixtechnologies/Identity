<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Last 3.5.x; see the platform's pom for why the JDK moves a release before the framework
             does. Spring Authorization Server's version is managed from here, so it follows. -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.prabhix</groupId>
    <artifactId>identity</artifactId>
    <version>1.0.0</version>
    <name>prabhix-identity</name>
    <description>Prabhix Identity — authentication and token issuance for every Prabhix product</description>

    <properties>
        <!-- Matches the platform: 25 in production, and -Djava.version=17 builds on an older local
             JDK because nothing here needs a newer language level to compile. -->
        <java.version>25</java.version>
        <build.dir>${project.basedir}/target</build.dir>
        <jjwt.version>0.12.6</jjwt.version>
        <webauthn4j.version>0.31.9.RELEASE</webauthn4j.version>
        <!-- Same version the platform backend sends SES mail with, so that both services talk to SES
             through identical client behaviour. -->
        <awssdk.version>2.29.52</awssdk.version>
        <!--
          3.x is the line built against Boot 4. 2.8.x reads a WebMvcProperties that Boot 4 moved, so
          SwaggerConfig cannot be introspected and the context refuses to start — not a compile error,
          since springdoc is only on the classpath, so the integration tests are what catch it.
        -->
        <springdoc.version>3.1.0</springdoc.version>
        <!--
          Testcontainers is version-managed by the Boot parent from 4.x on, so the pin is gone and the
          modules inherit it. Note that 2.x renamed every module to carry a testcontainers- prefix and
          dropped the self-referential generics.
        -->
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!--
              webmvc, not web. spring-boot-starter-web still resolves but is deprecated for removal: it
              is the classic aggregate and pulls in HTTP clients and JSON support regardless of whether
              they are wanted, which is the coupling the 4.x split exists to undo.
            -->
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!--
          webmvc brings no JSON library of its own, so the mapper that writes every token response and
          discovery document has to be asked for explicitly.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <!--
          Nor does webmvc auto-configure an HTTP client any more, and RestClient.Builder is injected by
          the SMS sender to reach the gateway. Without this the context cannot be built, so a missing
          HTTP client presents as the whole identity provider failing to start rather than as phone
          sign-in being unavailable.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          Boot 4 does not auto-configure CloudWatch export. Wired in CloudWatchMetricsConfiguration
          when CLOUDWATCH_METRICS=true (or profile cloudwatch). Off by default so tests stay local.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-cloudwatch2</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
            <version>${awssdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- The OAuth2/OIDC protocol surface: /oauth2/authorize, /oauth2/token, /userinfo,
             introspection, revocation and RP-initiated logout, with PKCE and consent.
             Deliberately not hand-written. An authorization server is one of the few places where a
             subtle mistake is a full account takeover, and this one is OIDC-certified. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!--
              Renamed to sit under the security family in Boot 4; the old id still resolves but is
              deprecated. The artifact behind it now ships as part of Spring Security 7 rather than as
              the separate Spring Authorization Server project.
            -->
            <artifactId>spring-boot-starter-security-oauth2-authorization-server</artifactId>
        </dependency>
        <!-- Server-rendered login and consent pages. The one login UI every product redirects to has
             to be served from this origin, so that the session cookie which makes single sign-on work
             is set here and nowhere else. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
          Auth mail is sent from here rather than handed to the platform, which would make identity
          depend on a product it is meant to sit underneath.

          Still needed with SES as the production transport: this brings jakarta.mail, which builds
          the MIME message that SES is handed raw, and JavaMailSender, which is the SMTP transport
          used in development.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!--
          SES through its API rather than its SMTP interface, so that the only credential involved is
          the instance role. SMTP submission would need a static access key in the environment,
          because SES SMTP credentials are an IAM secret put through a derivation.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sesv2</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          The starter, not flyway-core alone: Boot 4 moved Flyway's auto-configuration out of the
          monolithic autoconfigure jar into spring-boot-flyway, which only the starter brings. With
          bare flyway-core the migrations silently stop running at startup.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
          jjwt, the same version the platform signs with today, so a token this service issues and a
          token the platform issues are produced by identical library behaviour during the cutover.
          It also carries the JWK support that builds the JWKS document and computes the RFC 7638
          thumbprint used as the key id.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          Server-side WebAuthn / passkey verification. Kept on the latest line that targets Jackson 3,
          matching Boot 4's mapper stack. Ceremony options and attestation/assertion checks live here;
          credential persistence is ours.
        -->
        <dependency>
            <groupId>com.webauthn4j</groupId>
            <artifactId>webauthn4j-core</artifactId>
            <version>${webauthn4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          The per-technology test starters replace the single spring-boot-starter-test, which they all
          bring transitively anyway. Not cosmetic: in Boot 4 the test auto-configuration ships beside
          each technology, so @WithMockUser and the rest need spring-boot-starter-security-test on the
          classpath to do anything at all, and the old arrangement left them quietly inert.
        -->
        <!--
          Kept after the Boot 4 upgrade rather than removed with it. Boot ignores a configuration key
          it no longer recognises without saying anything, so a renamed property does not fail, it just
          silently reverts to the default — which is how server.error.include-stacktrace stopped being
          configured here and nothing noticed. Test scope, so it costs production nothing and reports
          in the build instead.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-properties-migrator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Tests run against real Postgres, not H2. The schema uses citext and jsonb, and a
          substitute database would let a migration that cannot apply in production pass here.

          testcontainers- prefixes because org.testcontainers:postgresql stops at 1.21.4 and does not
          exist at 2.x. The version comes from the Boot parent so the modules match the Testcontainers
          that Boot's own test support was built against; Boot sets the property but does not manage
          these artifacts, hence the explicit version.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>prabhix-identity</finalName>
        <directory>${build.dir}</directory>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Sets the groupId:artifactId:type properties surefire uses to locate the agent jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                    <!-- Loads Mockito's agent at startup instead of letting it attach to a running
                         JVM, which the JDK warns about now and will refuse later. See the platform's
                         pom for why there is no @{argLine} prefix. -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Production still targets 25. Maven on many laptops uses JAVA_HOME 17, which cannot
          emit release 25. Below 25, emit 17 bytecode; a 25 runtime still gets JVM features.
        -->
        <profile>
            <id>jdk-below-25</id>
            <activation>
                <jdk>[1.8,25)</jdk>
            </activation>
            <properties>
                <java.version>17</java.version>
            </properties>
        </profile>
        <!-- mvn test -Pintegration  → also runs Testcontainers-backed tests -->
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <!-- Merged, not overridden, so the Mockito agent configured above survives
                             into this profile. The inner override is what clears excludedGroups. -->
                        <configuration>
                            <excludedGroups combine.self="override"/>
                            <environmentVariables>
                                <DOCKER_HOST>${testcontainers.docker.host}</DOCKER_HOST>
                                <TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>/var/run/docker.sock</TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Same Docker Desktop pipe selection as the platform build; see backend/pom.xml. -->
        <profile>
            <id>docker-host-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <testcontainers.docker.host>npipe:////./pipe/dockerDesktopLinuxEngine</testcontainers.docker.host>
            </properties>
        </profile>
        <profile>
            <id>docker-host-unix</id>
            <activation>
                <os><family>unix</family></os>
            </activation>
            <properties>
                <testcontainers.docker.host>unix:///var/run/docker.sock</testcontainers.docker.host>
            </properties>
        </profile>
    </profiles>
</project>
